<!DOCTYPE html>
<html lang="fr" class="h-full">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}InkDrop
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📝</text></svg>">

		{% block stylesheets %}
			<script src="https://cdn.tailwindcss.com"></script>
		{% endblock %}

		{% block javascripts %}{% endblock %}
	</head>
	<body
		class="h-full bg-gray-50">
		{# Navigation #}
		<nav class="bg-white shadow-lg">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-16">
					<div class="flex">
						<div class="flex-shrink-0 flex items-center">
							<a href="{{ path('app_home') }}" class="text-2xl font-bold text-cyan-900">
								InkDrop
							</a>
						</div>
						<div class="hidden sm:ml-6 sm:flex sm:space-x-8">
							{% set current_route = app.request.attributes.get('_route') %}
							<a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'border-cyan-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
								Accueil
							</a>
							<a href="{{ path('app_articles') }}" class="{{ current_route in ['app_articles', 'app_article_show'] ? 'border-cyan-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
								Articles
							</a>
							<a href="{{ path('app_categories') }}" class="{{ current_route in ['app_categories', 'app_category_show'] ? 'border-cyan-9à0 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
								Catégories
							</a>
							{% if app.user and 'ROLE_ADMIN' in app.user.roles %}
								<a href="{{ path('app_admin') }}" class="{{ current_route in ['app_admin', 'app_article_edit', 'app_article_delete'] ? 'border-cyan-900 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }} inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">
									Admin
								</a>
							{% endif %}
						</div>
					</div>
					<div class="hidden sm:ml-6 sm:flex sm:items-center space-x-4">
						{% if app.user %}
							<span class="text-gray-700">Bonjour,
								{{ app.user.firstname }}
								!</span>
							<a href="{{ path('app_logout') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700">
								Déconnexion
							</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
								Connexion
							</a>
							<a href="{{ path('app_register') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-cyan-900 hover:bg-cyan-950">
								Inscription
							</a>
						{% endif %}
					</div>
				</div>
			</div>
		</nav>

		{# Flash Messages #}
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
					<div class="rounded-md {% if label == 'success' %}bg-green-50 border-green-400{% elseif label == 'error' %}bg-red-50 border-red-400{% else %}bg-blue-50 border-blue-400{% endif %} border-l-4 p-4">
						<p class="{% if label == 'success' %}text-green-700{% elseif label == 'error' %}text-red-700{% else %}text-blue-700{% endif %}">
							{{ message }}
						</p>
					</div>
				</div>
			{% endfor %}
		{% endfor %}

		{# Main Content #}
		<main class="py-10"> {% block body %}{% endblock %}
			</main>

			{# Footer #}
			<footer class="bg-white border-t border-gray-200 mt-12">
				<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
						<div>
							<h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">À propos</h3>
							<p class="mt-4 text-base text-gray-500">
								Un blog moderne pour partager vos idées et découvrir de nouveaux contenus.
							</p>
						</div>
						<div>
							<h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">Navigation</h3>
							<ul class="mt-4 space-y-2">
								<li>
									<a href="{{ path('app_home') }}" class="text-base text-gray-500 hover:text-gray-900">Accueil</a>
								</li>
								<li>
									<a href="{{ path('app_articles') }}" class="text-base text-gray-500 hover:text-gray-900">Articles</a>
								</li>
								<li>
									<a href="{{ path('app_categories') }}" class="text-base text-gray-500 hover:text-gray-900">Catégories</a>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">Suivez-nous</h3>
							<div class="mt-4 flex space-x-6">
								<a href="#" class="text-gray-400 hover:text-gray-500">
									<span class="sr-only">Facebook</span>
									<svg class="h-6 w-6" fill="currentColor" viewbox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
								</a>
								<a href="#" class="text-gray-400 hover:text-gray-500">
									<span class="sr-only">Twitter</span>
									<svg class="h-6 w-6" fill="currentColor" viewbox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
								</a>
							</div>
						</div>
					</div>
					<div class="mt-8 border-t border-gray-200 pt-8">
						<p class="text-base text-gray-400 text-center">&copy; 2025 InkDrop. Tous droits réservés.</p>
					</div>
				</div>
			</footer>
		</body>
	</html>
