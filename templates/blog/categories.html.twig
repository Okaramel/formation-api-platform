{% extends 'base.html.twig' %}

{% block title %}Catégories - InkDrop{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Toutes les catégories</h1>
        <p class="text-lg text-gray-600 mb-12">Explorez nos différentes catégories d'articles</p>

        {% if categories|length > 0 %}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {% for category in categories %}
            {% set emojis = ['📚', '💻', '🎨', '🎮', '🌍', '🍔', '⚽', '🎵', '📸', '✈️'] %}
            {% set emojiIndex = loop.index0 % 10 %}
            <a href="{{ path('app_category_show', {id: category.id}) }}"
               class="group relative rounded-xl border-2 border-gray-200 bg-white p-8 hover:border-cyan-500 hover:shadow-xl transition-all">
                <div class="flex items-center justify-between mb-4">
                    <div class="h-12 w-12 rounded-lg bg-cyan-900 flex items-center justify-center text-2xl group-hover:bg-cyan-900 group-hover:text-white transition-colors">
                        {{ emojis[emojiIndex] }}
                    </div>
                    <span class="text-2xl font-bold text-cyan-900">{{ category.articleId|length }}</span>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-cyan-900 mb-2">
                    {{ category.title }}
                </h3>
                <p class="text-sm text-gray-500">
                    {{ category.articleId|length }} article{{ category.articleId|length > 1 ? 's' : '' }}
                </p>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-20">
            <div class="text-gray-400 mb-6">
                <svg class="mx-auto h-24 w-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">Aucune catégorie</h3>
            <p class="text-gray-500">Les catégories seront disponibles prochainement.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
