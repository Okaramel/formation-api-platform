{% extends 'base.html.twig' %}

{% block title %}Accueil - InkDrop{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {# Hero Section #}
    <div class="text-center py-16">
        <h1 class="text-5xl font-extrabold text-gray-900 sm:text-6xl">
            Bienvenue sur InkDrop
        </h1>
        <p class="mt-6 text-xl text-gray-500 max-w-3xl mx-auto">
            Découvrez des articles passionnants sur tous les sujets qui vous intéressent.
            Partagez vos idées et connectez-vous avec notre communauté.
        </p>
        <div class="mt-10 flex justify-center gap-x-6">
            <a href="{{ path('app_articles') }}" class="rounded-md bg-cyan-900 px-6 py-3 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500">
                Parcourir les articles
            </a>
            {% if not app.user %}
            <a href="{{ path('app_register') }}" class="rounded-md bg-white px-6 py-3 text-lg font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                Rejoindre la communauté
            </a>
            {% endif %}
        </div>
    </div>

    {# Latest Articles #}
    <div class="py-12">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold text-gray-900">Derniers articles</h2>
            <a href="{{ path('app_articles') }}" class="text-cyan-900 hover:text-sky-900 font-medium">
                Voir tous les articles →
            </a>
        </div>

        {% if articles|length > 0 %}
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {% for article in articles %}
            <article class="flex flex-col bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                <div class="flex-shrink-0">
                    <div class="h-48 w-full bg-gradient-to-r from-cyan-900 to-cyan-500 flex items-center justify-center">
                    </div>
                </div>
                <div class="flex-1 p-6 flex flex-col justify-between">
                    <div class="flex-1">
                        <a href="{{ path('app_article_show', {id: article.id}) }}" class="block mt-2">
                            <h3 class="text-xl font-semibold text-gray-900 hover:text-cyan-900">
                                {{ article.title }}
                            </h3>
                            <p class="mt-3 text-base text-gray-500 line-clamp-3">
                                {{ article.content|slice(0, 150) }}{% if article.content|length > 150 %}...{% endif %}
                            </p>
                        </a>
                    </div>
                    <div class="mt-6 flex items-center">
                        <div class="flex-shrink-0">
                            <div class="h-10 w-10 rounded-full bg-cyan-900 flex items-center justify-center text-white font-bold">
                                {{ article.userId.firstname|slice(0, 1)|upper }}{{ article.userId.lastname|slice(0, 1)|upper }}
                            </div>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-gray-900">
                                {{ article.userId.firstname }} {{ article.userId.lastname }}
                            </p>
                            <div class="flex space-x-1 text-sm text-gray-500">
                                <time datetime="{{ article.createdAt|date('Y-m-d') }}">
                                    {{ article.createdAt|date('d M Y') }}
                                </time>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-12">
            <p class="text-gray-500 text-lg">Aucun article pour le moment. Soyez le premier à en créer un!</p>
            {% if app.user %}
            <a href="/api" class="mt-4 inline-block text-indigo-600 hover:text-indigo-500 font-medium">
                Créer mon premier article →
            </a>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {# CTA Section #}
    {% if not app.user %}
    <div class="bg-indigo-700 rounded-2xl my-16">
        <div class="px-6 py-16 sm:px-12 lg:px-16">
            <div class="max-w-2xl mx-auto text-center">
                <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
                    Prêt à partager vos idées?
                </h2>
                <p class="mt-6 text-lg leading-8 text-indigo-200">
                    Rejoignez notre communauté d'auteurs et commencez à publier vos articles dès aujourd'hui.
                </p>
                <div class="mt-10 flex items-center justify-center gap-x-6">
                    <a href="{{ path('app_register') }}"
                       class="rounded-md bg-white px-6 py-3 text-base font-semibold text-indigo-600 shadow-sm hover:bg-indigo-50">
                        S'inscrire gratuitement
                    </a>
                    <a href="{{ path('app_login') }}"
                       class="text-base font-semibold leading-6 text-white hover:text-indigo-100">
                        Se connecter <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}