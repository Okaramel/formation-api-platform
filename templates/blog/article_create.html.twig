{% extends 'base.html.twig' %}

{% block title %}Créer un article - InkDrop
{% endblock %}

{% block body %}
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="bg-white shadow-lg rounded-lg p-8">
			<h1 class="text-3xl font-bold text-gray-900 mb-8">Créer un nouvel article</h1>

			{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

			<div>
				{{ form_label(form.Title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.Title, {'attr': {'class': 'mt-1 p-2 block w-full rounded-md border border-cyan-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
				{{ form_errors(form.Title) }}
			</div>

			<div>
				{{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.content, {'attr': {'class': 'mt-1 p-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 10}}) }}
				{{ form_errors(form.content) }}
			</div>

			<div>
				{{ form_label(form.category_id, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.category_id, {'attr': {'class': 'mt-1 p-2 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
				{{ form_errors(form.category_id) }}
			</div>


			<div class="flex items-center justify-between pt-6">
				<a href="{{ path('app_articles') }}" class="text-gray-600 hover:text-gray-900">
					← Retour aux articles
				</a>
				<button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-cyan-700 hover:bg-cyan-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
					Créer l'article
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
