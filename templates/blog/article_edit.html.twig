{% extends 'base.html.twig' %}

{% block title %}Modifier l'article - InkDrop
{% endblock %}

{% block body %}
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="bg-white shadow-lg rounded-lg p-8">
			<h1 class="text-3xl font-bold text-gray-900 mb-8">Modifier l'article</h1>

			{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

			<div>
				{{ form_label(form.Title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.Title, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
				{{ form_errors(form.Title) }}
			</div>

			<div>
				{{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.content, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500', 'rows': 10}}) }}
				{{ form_errors(form.content) }}
			</div>

			<div>
				{{ form_label(form.category_id, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(form.category_id, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
				{{ form_errors(form.category_id) }}
			</div>

			{% if form.user_id is defined %}
				<div>
					{{ form_label(form.user_id, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(form.user_id, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
					{{ form_errors(form.user_id) }}
				</div>
			{% endif %}

			<div class="flex items-center justify-between pt-6">
				<a href="{{ path('app_admin') }}" class="text-gray-600 hover:text-gray-900">
					← Retour à l'administration
				</a>
				<button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
					Enregistrer les modifications
				</button>
			</div>

			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
